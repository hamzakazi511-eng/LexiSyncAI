# Copy to .env (docker compose) or export these in your shell.
# LLM backend: ollama | openai | extractive
LEXI_LLM_BACKEND=ollama
LEXI_OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Fallback if your laptop cannot run a local model: any OpenAI-compatible API (e.g. Groq free tier)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LEXI_OPENAI_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=

LEXI_SEED=42
